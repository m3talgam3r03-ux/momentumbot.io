# Copia questo file in .env e compilalo. .env NON va mai committato.
# api_id e api_hash si ottengono da https://my.telegram.org (sezione "API development tools")
# con l'account Telegram DEDICATO al bot (con verifica in due passaggi attiva).
TG_API_ID=
TG_API_HASH=
# Percorso del file di sessione Telethon (senza estensione .session).
# Proteggi il file: chi lo possiede controlla l'account Telegram.
TG_SESSION_PATH=data/momentum_reader
